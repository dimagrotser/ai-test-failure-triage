diff --git a/wallet/rate_limit.py b/wallet/rate_limit.py
new file mode 100644
--- /dev/null
+++ b/wallet/rate_limit.py
@@ -0,0 +1,15 @@
+LIMIT = 3
+
+_calls = 0
+
+
+class RateLimited(Exception):
+    pass
+
+
+def check_quota() -> None:
+    global _calls
+    if _calls >= LIMIT:
+        _calls = 0
+        raise RateLimited(f"more than {LIMIT} calls in this window")
+    _calls += 1
